# Arch Linux Mirror - Environment Configuration
# Copy to .env and configure (chmod 600 .env)
# All values have defaults in docker-compose.yml; this file overrides them.

# =============================================================================
# Mirror Source Configuration
# =============================================================================
# Official Arch Linux rsync mirrors: https://archlinux.org/mirrors/
# Choose one geographically close to your server.
# Examples:
#   rsync://mirror.rackspace.com/archlinux/
#   rsync://mirrors.kernel.org/archlinux/
#   rsync://mirror.csclub.uwaterloo.ca/archlinux/
#   rsync://archlinux.mirror.liquidtelecom.com/archlinux/
MIRROR_SOURCE=rsync://mirror.rackspace.com/archlinux/

# =============================================================================
# Sync Schedule (for reference; actual timer is in systemd/arch-mirror-sync.timer)
# =============================================================================
# Every 4 hours (default): 00,04,08,12,16,20
# Every 2 hours: 00,02,04,06,08,10,12,14,16,18,20,22
# Daily at 3 AM: 03
SYNC_SCHEDULE=00,04,08,12,16,20

# =============================================================================
# Domain Configuration
# =============================================================================
# Base domain for the mirror (must match Cloudflare DNS + Traefik config)
MIRROR_DOMAIN=itanishq.space
MIRROR_SUBDOMAINS=arch,mirror

# =============================================================================
# Image Tags (same ${VAR:-default} pattern as octoport's IMAGE_TAG)
# =============================================================================
# Pin or float each image independently. Watchtower only acts when the
# corresponding com.centurylinklabs.watchtower.enable label is true.
NGINX_TAG=alpine
IMAGE_TAG=latest

# =============================================================================
# Resource Limits (adjust based on your server capacity)
# =============================================================================
# Memory limits are hardcoded in docker-compose.yml (mem_limit) to match the
# octoport convention. Edit them there, not here.

# =============================================================================
# Exporter Configuration
# =============================================================================
# Path to mirror data (bind-mounted from host)
MIRROR_PATH=/mirror
# Path to sync log on host (for parsing last sync status)
SYNC_LOG_PATH=/var/log/arch-mirror-sync.log

# =============================================================================
# Optional: Watchtower Auto-Update
# =============================================================================
# Set to "false" to disable auto-updates for this stack
WATCHTOWER_ENABLE=true